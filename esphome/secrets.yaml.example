# ==============================================================================
# ESPHome Secrets Template — LilyGo T5 4.7" E-Paper Touch [H716] Dashboard
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy or rename this file to `secrets.yaml` inside your `/config/esphome/`
#    directory (or add these keys to your existing ESPHome `secrets.yaml`).
# 2. Replace the placeholder values below with your actual Wi-Fi credentials,
#    static IP configuration, and Home Assistant API encryption key.
# ==============================================================================

# 2.4 GHz Wi-Fi Network Credentials (ESP32-S3 requires 2.4 GHz Wi-Fi)
wifi_ssid: "Your_2.4GHz_WiFi_SSID"
wifi_password: "Your_WiFi_Password"

# Static IPv4 Configuration (Shaves ~2.5s off DHCP handshake on every battery wake!)
static_ip: "192.168.1.185"
gateway_ip: "192.168.1.1"
subnet_mask: "255.255.255.0"
dns_ip: "192.168.1.1"

# Home Assistant Native API 32-Byte Base64 Encryption Key
# Generate a fresh key at https://esphome.io/components/api.html or in the ESPHome UI
api_encryption_key: "YWJjZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXoxMjM0NTY="

# Over-The-Air (OTA) Wireless Firmware Update Password
ota_password: "ChangeMe_OTA_Password_2026"
